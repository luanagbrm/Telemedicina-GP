# ============================================================
# TeleMed+ — Dev setup environment (copy to .env)
#   cp .env.example .env
# NEVER commit the real .env file.
#
# Backend-specific settings (JWT/auth, WhatsApp, LLM, transcription) belong to
# the backend task and are added there.
# ============================================================

# ---- App ----
APP_NAME=TeleMed+
ENVIRONMENT=development           # development | staging | production
DEBUG=true
API_HOST=0.0.0.0
API_PORT=8000

# ---- Database (MySQL / Aiven) ----
# DEFAULT: the managed Aiven MySQL. Copy these from the Aiven service overview.
DB_HOST=chatbot-2026-grazibatista2005-c2c8.l.aivencloud.com
DB_PORT=10488
DB_USER=avnadmin
DB_PASSWORD=CHANGE_ME
DB_NAME=defaultdb
DB_SSL=true
DB_SSL_CA=
#
# LOCAL DOCKER DB instead (offline dev): use these values and turn TLS off.
#   DB_HOST=127.0.0.1
#   DB_PORT=3306
#   DB_USER=telemed
#   DB_PASSWORD=telemed_dev_pw
#   DB_NAME=telemed
#   DB_SSL=false
#
# Optional full-URL override (wins over the parts above):
# DATABASE_URL=mysql+mysqlconnector://user:pass@host:3306/dbname
# Set to true only when you need to trace every SQL statement in the logs.
DB_ECHO=false
